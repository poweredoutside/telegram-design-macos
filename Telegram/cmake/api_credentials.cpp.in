#include "config.h"
#include "core/api_credentials.h"

const int ApiId = @TDESKTOP_API_ID@;
const char ApiHash[] = "@TDESKTOP_API_HASH@";

namespace Core::ApiCredentials {

void Prepare(QObject *, Fn<void(bool)> done) {
	done(true);
}

int Id() {
	return ApiId;
}

const char *Hash() {
	return ApiHash;
}

int CrashReportId() {
	return ApiId;
}

} // namespace Core::ApiCredentials
